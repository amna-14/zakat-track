# Copy this file to ".env" (same folder) and change the values.
# NEVER upload the real .env file to GitHub. It is listed in .gitignore.

# Long random secret used to sign JWTs (at least 32 characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters

PORT=3000

# Only needed if the pages are opened from GitHub Pages and the backend runs somewhere else.
# Comma-separated list, no trailing slash. Example: https://yourname.github.io
ALLOWED_ORIGINS=

# Set to 1 only when the server runs behind a hosting proxy (e.g. Render)
TRUST_PROXY=
